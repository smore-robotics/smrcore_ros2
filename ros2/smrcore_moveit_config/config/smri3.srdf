<?xml version="1.0" encoding="UTF-8"?>
<robot name="smri3">
  <group name="smri3_arm">
    <chain base_link="base_link" tip_link="tool0_link"/>
  </group>
  <group_state name="home" group="smri3_arm">
    <joint name="base_joint" value="0"/>
    <joint name="shoulder_joint" value="0"/>
    <joint name="elbow_joint" value="0"/>
    <joint name="wrist1_joint" value="0"/>
    <joint name="wrist2_joint" value="0"/>
    <joint name="wrist3_joint" value="0"/>
  </group_state>
  <group_state name="ready" group="smri3_arm">
    <joint name="base_joint" value="0"/>
    <joint name="shoulder_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="-1.5708"/>
    <joint name="wrist1_joint" value="0"/>
    <joint name="wrist2_joint" value="0"/>
    <joint name="wrist3_joint" value="0"/>
  </group_state>
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="lower_arm_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="proximal_wrist_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="distal_wrist_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="flange_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="tool0_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="lower_arm_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="proximal_wrist_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="distal_wrist_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="flange_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="tool0_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="lower_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="proximal_wrist_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="distal_wrist_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="flange_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="tool0_link" reason="Never"/>
  <disable_collisions link1="lower_arm_link" link2="proximal_wrist_link" reason="Adjacent"/>
  <disable_collisions link1="lower_arm_link" link2="distal_wrist_link" reason="Never"/>
  <disable_collisions link1="lower_arm_link" link2="flange_link" reason="Never"/>
  <disable_collisions link1="lower_arm_link" link2="tool0_link" reason="Never"/>
  <disable_collisions link1="proximal_wrist_link" link2="distal_wrist_link" reason="Adjacent"/>
  <disable_collisions link1="proximal_wrist_link" link2="flange_link" reason="Never"/>
  <disable_collisions link1="proximal_wrist_link" link2="tool0_link" reason="Never"/>
  <disable_collisions link1="distal_wrist_link" link2="flange_link" reason="Adjacent"/>
  <disable_collisions link1="distal_wrist_link" link2="tool0_link" reason="Never"/>
  <disable_collisions link1="flange_link" link2="tool0_link" reason="Adjacent"/>
</robot>
